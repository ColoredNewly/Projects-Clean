<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarAdd"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        app:titleTextColor="@android:color/white" />

    <!-- Scrollable form -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Name -->
            <TextView
                style="@style/FieldLabel"
                android:text="Назив на компанија *" />
            <EditText
                android:id="@+id/etName"
                style="@style/FormField"
                android:hint="Внесете назив"
                android:inputType="textCapWords" />

            <!-- Address -->
            <TextView
                style="@style/FieldLabel"
                android:text="Адреса *" />
            <EditText
                android:id="@+id/etAddress"
                style="@style/FormField"
                android:hint="Внесете адреса"
                android:inputType="textPostalAddress" />

            <!-- Coordinates row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/FieldLabel"
                        android:text="Географска ширина" />
                    <EditText
                        android:id="@+id/etLatitude"
                        style="@style/FormField"
                        android:hint="41.9981"
                        android:inputType="numberDecimal|numberSigned" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/FieldLabel"
                        android:text="Географска должина" />
                    <EditText
                        android:id="@+id/etLongitude"
                        style="@style/FormField"
                        android:hint="21.4254"
                        android:inputType="numberDecimal|numberSigned" />
                </LinearLayout>
            </LinearLayout>

            <!-- Email -->
            <TextView
                style="@style/FieldLabel"
                android:text="Контакт е-маил" />
            <EditText
                android:id="@+id/etEmail"
                style="@style/FormField"
                android:hint="email@example.com"
                android:inputType="textEmailAddress" />

            <!-- Phone -->
            <TextView
                style="@style/FieldLabel"
                android:text="Телефон" />
            <EditText
                android:id="@+id/etPhone"
                style="@style/FormField"
                android:hint="+389 XX XXX XXX"
                android:inputType="phone" />

            <!-- Website -->
            <TextView
                style="@style/FieldLabel"
                android:text="Веб страна" />
            <EditText
                android:id="@+id/etWebsite"
                style="@style/FormField"
                android:hint="https://www.example.com"
                android:inputType="textWebEmailAddress" />

            <!-- Categories -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="8dp"
                android:text="Категории (изберете барем една)" />

            <CheckBox
                android:id="@+id/cbServices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Сервиси"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cbEntertainment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Забава"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cbIndustry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Индустрија"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cbEducation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Едукација"
                android:textSize="15sp" />

            <!-- Save button -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/colorPrimary"
                android:text="Зачувај"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
